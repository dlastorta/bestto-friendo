<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TournamentManager.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.3" />
    <!-- Actualiza transitiva Microsoft.OpenApi 2.0.0 afectada por GHSA-v5pm-xwqc-g5wc. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Necesario para dotnet-ef con este startup project; solo dependencia de diseño. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TournamentManager.Application/TournamentManager.Application.csproj" />
    <ProjectReference Include="../TournamentManager.Infrastructure/TournamentManager.Infrastructure.csproj" />
  </ItemGroup>
</Project>
